# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=supabase_url
SUPABASE_SECRET_KEY=sb_secret_xxx            # pragma: allowlist secret
DATABASE_URL=database_url
MIGRATION_DATABASE_URL=migration_database_url

# Used by the initial Alembic migration to create the least-privilege app_user DB role.
APP_USER_PASSWORD=app_database_user_password

# ── Document storage / upload ────────────────────────────
# The bucket must be created out-of-band in Supabase as PRIVATE, with
# file_size_limit = MAX_UPLOAD_SIZE_MB and allowed_mime_types restricted to
# pdf/docx/xlsx/xls. See README_BACKEND.md.
SUPABASE_STORAGE_BUCKET=rfq-documents
MAX_UPLOAD_SIZE_MB=50
SIGNED_DOWNLOAD_URL_TTL_S=600
STORAGE_CLIENT_TIMEOUT_S=120
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.xls

# ── LLM (OpenRouter) ─────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
PRIMARY_MODEL=anthropic/claude-opus-4.7
FALLBACK_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT_S=60.0

# ── App ──────────────────────────────────────────────────
APP_ENV=local
DEBUG=false
LOG_LEVEL=DEBUG

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
